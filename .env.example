# ==============================================================================
# JIRA CLOUD CONFIGURATION (100% Free Forever for up to 10 users)
# ==============================================================================
JIRA_DOMAIN=your-domain.atlassian.net
JIRA_EMAIL=sre-bot@example.com
JIRA_API_TOKEN=your_atlassian_api_token
JIRA_PROJECT_KEY=KAN

# ==============================================================================
# MULTI-AGENT SRE CREW & FREE-TIER AI ENGINE CONFIGURATION
# ==============================================================================
# Active Provider: "gemini" (Default, Free via Google AI Studio), "ollama" (Local Offline), or "groq"
LLM_PROVIDER=gemini

# Option A: Google Gemini Free Tier (15 RPM / 1M TPM / 1,500 RPD Free at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key

# Option B: Local Ollama (100% Free, Offline, Zero Tokens Cost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Option C: Groq Free Tier (Ultra-Fast Llama 3 Inference)
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile

# ==============================================================================
# REDIS ALERT STORM PROTECTION & DEDUPLICATION (Local Docker or in-memory)
# ==============================================================================
REDIS_URL=redis://localhost:6379

# ==============================================================================
# SERVICE RUNTIME SETTINGS
# ==============================================================================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CREWAI_PROCESS_TIMEOUT=60
